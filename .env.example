# Copy to .env next to docker-compose.yml and adjust. Never commit the real .env.

# --- Images ---------------------------------------------------------------------------
# Image path without the -api/-web suffix (GitHub user/org in lower case).
WISHLIST_IMAGE=ghcr.io/your-github-user/wishlist
# Tag to run: e.g. 1.2.0 (exact), 1.2 (latest patch), latest.
WISHLIST_VERSION=latest
# Host port of the stack. Use 127.0.0.1:8080 when a reverse proxy on the same server handles HTTPS.
WISHLIST_PORT=127.0.0.1:8080

# --- App ------------------------------------------------------------------------------
# Required. Secret for login tokens, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Proxies in front of the API: 1 = only the web container, 2 = web container + your HTTPS reverse proxy.
TRUST_PROXY=2
# Other origins allowed to call the API (e.g. a native app later). The web app itself doesn't need this.
CORS_ORIGINS=https://wishlist.example.com
# Language requested from shops when reading product pages.
SCRAPER_ACCEPT_LANGUAGE=de-DE,de;q=0.9,en-US;q=0.8,en;q=0.7
