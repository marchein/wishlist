PORT=3000
# Required in production. In development a secret is generated and stored in data/jwt-secret.
JWT_SECRET=
DATABASE_FILE=data/wishlist.db
UPLOAD_DIR=data/uploads
# Comma-separated list of allowed frontend origins (add capacitor://localhost etc. for a native app later)
CORS_ORIGINS=http://localhost:4200,http://localhost:8100
# Set to e.g. 1 when running behind a reverse proxy, so rate limiting sees real client IPs
TRUST_PROXY=
SCRAPER_ACCEPT_LANGUAGE=de-DE,de;q=0.9,en-US;q=0.8,en;q=0.7
